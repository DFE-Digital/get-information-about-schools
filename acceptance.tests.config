<?xml version="1.0" encoding="utf-8"?>
<!-- Pipeline config file-->
<!-- Config for acceptance tests running against the UI in Azure for the set environment -->
<!-- The values are injected by the acceptance-test pipeline before tests run -->
<configuration>
	<connectionStrings>
		<!-- Persistent storage -->
		<add name="DataConnectionString" connectionString="" />
		<add name="FrontEndDatabase" connectionString="" />
	</connectionStrings>
	<appSettings>
		<!-- Signin settings -->
		<add key="Environment" value="" />
		<add key="GiasFrontEndBaseAddress" value="" />
		<add key="HttpAuthModule.Credentials" value="" />

		<!-- Feature flags -->
		<add key="Feature_UserPreferencesMigration" value="" />
	</appSettings>
</configuration>
