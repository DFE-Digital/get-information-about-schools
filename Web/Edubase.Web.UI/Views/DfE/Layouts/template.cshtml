@using System.Linq
@using Edubase.Web.UI.Controllers
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = "../../govuk/layouts/template.cshtml";
    var version = typeof(HomeController).Assembly.GetName().Version;
}


@if (ViewContext.Controller.GetType().Name != nameof(NotificationsController))
{
    Html.RenderAction("BannersPartial", "Notifications", new { area = "" });
}

@section Head {
    @(RenderSection("Head", required: false))
}

@RenderSection("BackLink", false)
@RenderSection("BreadCrumbs", false)

<main id="main-content" class="govuk-main-wrapper @(ViewBag.pageClass)" role="main">
    @RenderBody()
</main>

@section BodyEnd {

    @if (!Context.Request.Headers.UserAgent.Any(x => x.Contains("MSIE 8", StringComparison.OrdinalIgnoreCase)))
    {
        <script nonce="@Html.ScriptNonce()">
            var azureMapsApiKey = "@(Configuration["AzureMapsApiKey"])";
        </script>

        <script src="@Html.Raw(Html.GetWebpackScriptUrl("bundle.*.js"))"></script>
        @(RenderSection("ViewScripts", required: false))
    }
}
