<?xml version="1.0" encoding="utf-8"?>
<!-- Azure DevOps pipeline config file. DO NOT EDIT -->
<!-- Config for acceptance tests running against the UI in Azure for the configured environment -->
<!-- The values are injected as part of the RunAcceptanceTests job in the build/deploy pipeline YAML -->
<configuration>
	<connectionStrings>
		<!-- Persistent storage -->
		<add name="AzureTableStorage" connectionString="" />
		<add name="AzureSqlServer" connectionString="" />
	</connectionStrings>
	<appSettings>
		<!-- Signin settings -->
		<add key="Environment" value="" />
		<add key="GiasFrontEndBaseAddress" value="" />
		<add key="HttpAuthModule.Credentials" value="" />

		<!-- Feature flags -->
		<add key="Feature_UserPreferencesMigration" value="" />
	</appSettings>
</configuration>
